{
    "general": {
        "accentColor": "DEFAULT_ACCENT_COLOR",
        "checkForMillenniumUpdates": true,
        "checkForPluginAndThemeUpdates": true,
        "injectCSS": true,
        "injectJavascript": true,
        "millenniumUpdateChannel": "beta",
        "onMillenniumUpdate": 2,
        "shouldShowThemePluginUpdateNotifications": true
    },
    "misc": {
        "hasShownWelcomeModal": true
    },
    "notifications": {
        "showNotifications": true,
        "showPluginNotifications": true,
        "showUpdateNotifications": true
    },
    "plugins": {
        "enabledPlugins": [
            "achievement-groups",
            "adamraichu.auto-accept-custom-launch-args",
            "browser_history",
            "dotastats",
            "dwmx",
            "extendium",
            "global_launch_options",
            "gratitude",
            "hltb-for-millennium",
            "leetify-extension",
            "non-steam-playtimes",
            "protondb",
            "RSS-feed-in-whats-new",
            "size-on-disk",
            "steam-change-window-params",
            "steam-collections-plus",
            "steam-easygrid",
            "steam-librarian",
            "veygax.valve-internal-enabler",
            "easy-restart-reload-for-steam",
            "playercount-badge",
            "steam-share",
            "steam-game-renamer",
            "recent-chats",
            "steam-taskbar-progress",
            "__uwp_library_sync__",
            "protondb-library-badges",
            "sortium"
        ],
        "__uwp_library_sync__": {
            "config": {
                "auto_resync_on_startup": true,
                "default_disablelist_enabled": true,
                "disabled_shortcuts": "[]"
            }
        }
    },
    "themes": {
        "activeTheme": "MochaSteam",
        "allowedScripts": true,
        "allowedStyles": true,
        "conditions": {
